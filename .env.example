# --- Project ---
PROJECT_NAME=dss150p_repro
ENV=local

# --- Paths (relative to repo root) ---
DATA_SOURCE_DIR=data/source
DATA_RAW_DIR=data/raw
DATA_STAGING_DIR=data/staging
DATA_CURATED_DIR=data/curated
DATA_PARTITIONED_DIR=data/partitioned
DATA_QUARANTINE_DIR=data/quarantine
OUTPUTS_DIR=outputs
MODEL_DIR=outputs/model

# --- Source dataset ---
SOURCE_FILENAME=dft-road-casualty-statistics-collision-last-5-years.csv
SOURCE_SHA256=06a03c0e5504175e23ed98e3e0b4767ac61d396c073405a1bddab9339c18f948

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p_user
POSTGRES_PASSWORD=change_me_local_only

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dss150p_user:change_me_local_only@postgres:5432/dss150p

# --- Model / reproducibility ---
RANDOM_SEED=42
TRAIN_TEST_SPLIT=0.2
TARGET_COLUMN=collision_severity

# --- Incremental simulation ---
INCREMENTAL_BATCHES=3
